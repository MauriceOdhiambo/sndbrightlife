{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sndbrightlife",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "ignore": [
      "node_modules/**",
      "api/**",
      "cron/**",
      "*.md",
      ".env*",
      ".gitignore",
      "wrangler.jsonc",
      "package.json",
      "vercel.json",
      "package-lock.json",
      "bun.lockb"
    ]
  }
}
